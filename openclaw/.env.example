# OpenClaw Docker Configuration
# Copy this to .env and fill in your values

# Directories (adjust paths for your server)
OPENCLAW_CONFIG_DIR=/home/user/openclaw-state
OPENCLAW_WORKSPACE_DIR=/home/user/openclaw-workspace

# Gateway settings
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=  # Generate with: openssl rand -hex 24

# API Keys
ANTHROPIC_API_KEY=
GH_TOKEN=  # GitHub personal access token

# Optional: Claude web session (for Claude.ai features)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=
