# Reference only: nothing in this repo reads this file. The server .env is written
# by infra/src/cloud-init.ts from Pulumi secrets.

# OpenClaw
OPENCLAW_GATEWAY_TOKEN=  # Generate with: openssl rand -hex 24
OPENCLAW_WORKSPACE_DIR=./workspace
ANTHROPIC_API_KEY=
GH_TOKEN=

# Multi-agent Telegram tokens
TELEGRAM_BUCKBOT_TOKEN=your_buckbot_token_from_botfather
TELEGRAM_EXPENSE_TOKEN=your_expense_token_from_botfather

# ExpenseBot Playwright Connect (your Mac's Tailscale hostname)
EXPENSE_PLAYWRIGHT_HOST=your-mac-tailscale-hostname
